$SPECULARPOWER 2.000000




$SUBMATERIAL $TEXTURE
$TEXTURE 1 blankspecular.dds
$TEXTURE 2 blankbump.dds

$DIFFUSECOLOR 0.600000 0.600000 0.600000 1.000000
$SPECULARCOLOR 1.050000 1.050000 1.050000 1.050000
